<mxfile host="Oimbra"><diagram id="er" name="ER Batch"><mxGraphModel grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c11" value='&lt;b&gt;Modelo de datos – Procesos&lt;/b&gt; &lt;font style="font-size:11px;color:#555555"&gt;(esquema Batch)&lt;/font&gt;' style="text;html=1;fontSize=16;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="-60" width="900" height="30" as="geometry"/></mxCell><mxCell id="e901" value='&lt;b&gt;Carga&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px;color:#555555"&gt;Batch.Upload&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="180" height="46" as="geometry"/></mxCell><mxCell id="c12" value="Cada línea une la entidad que referencia (extremo múltiple) con la referenciada (extremo simple). Colores: verde inventario, amarillo personas y empresas, azul reservas, rojo precios y facturación. Con borde discontinuo, entidades de otras áreas." style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="76" width="1100" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>